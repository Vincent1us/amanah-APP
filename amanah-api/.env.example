APP_NAME=Amanah
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database: pilih salah satu ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amanah_db
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=amanah_db
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email OTP: "log" = ditulis ke storage/logs/laravel.log (development)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@amanah.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- OTP ----
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_LOCKOUT_MINUTES=15
# true = kode OTP ikut dikembalikan di response (field data.debug_otp) agar mudah dites di Postman.
# WAJIB false di production!
OTP_EXPOSE_IN_RESPONSE=true

# WhatsApp: log (development) | http (gateway sungguhan, mis. Fonnte)
WHATSAPP_DRIVER=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_AUTH_HEADER=Authorization

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=15
